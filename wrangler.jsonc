{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suredeal",
  "main": "./worker.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE_DO",
        "class_name": "SureDealStoreDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SureDealStoreDO"]
    }
  ]
}
